ALTER TABLE ONLY public.execution_logs
  ALTER COLUMN id SET DEFAULT nextval('public.execution_logs_id_seq'::regclass);

ALTER TABLE ONLY public.order_itens
  ALTER COLUMN iditempedido SET DEFAULT nextval('public.order_itens_iditempedido_seq'::regclass);

ALTER TABLE ONLY public.users
  ALTER COLUMN id SET DEFAULT nextval('public.users_id_seq'::regclass);

