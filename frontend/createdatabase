ALTER TABLE ONLY public.execution_logs
  ADD CONSTRAINT execution_logs_pkey PRIMARY KEY (id);

ALTER TABLE ONLY public.order_itens
  ADD CONSTRAINT order_itens_pkey PRIMARY KEY (iditempedido);

ALTER TABLE ONLY public.orders
  ADD CONSTRAINT orders_pkey PRIMARY KEY (idpedido);

ALTER TABLE ONLY public.users
  ADD CONSTRAINT users_pkey PRIMARY KEY (id);

ALTER TABLE ONLY public.users
  ADD CONSTRAINT users_username_key UNIQUE (username);

